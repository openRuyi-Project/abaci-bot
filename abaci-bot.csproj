<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>abaci_bot</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AnalysisMode>Recommended</AnalysisMode>
        <ServerGarbageCollection>false</ServerGarbageCollection>
    </PropertyGroup>

    <ItemGroup>
      <Content Update="appsettings.json" CopyToPublishDirectory="Never" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Octokit" Version="14.0.0" />
      <PackageReference Include="Octokit.Webhooks" Version="4.2.3" />
      <PackageReference Include="Octokit.Webhooks.AspNetCore" Version="4.2.3" />
      <PackageReference Include="ZstdSharp.Port" Version="0.8.4" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="tests\**" />
      <Content Remove="tests\**" />
      <EmbeddedResource Remove="tests\**" />
      <None Remove="tests\**" />
      <EmbeddedResource Include="Resources\spdx-licenses.json" />
      <EmbeddedResource Include="Resources\spdx-exceptions.json" />
    </ItemGroup>

    <ItemGroup>
      <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
        <_Parameter1>abaci-bot.Tests</_Parameter1>
      </AssemblyAttribute>
    </ItemGroup>

</Project>
