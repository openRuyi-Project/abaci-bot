{
  "GitHubApp": {
    "AppId": 123456,
    "InstallationId": 78901234,
    "PrivateKey": "-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----",
    "WebhookSecret": "webhook_secret",
    "TeamName": "captains"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:3456"
      }
    }
  },
  "TargetClassification": {
    "LtsRepositories": [],
    "LtsBranchPrefixes": [ "lts/", "lts-" ],
    "RollingBranches": [ "main", "master", "rolling" ],
    "DefaultTarget": "Rolling"
  },
  "ChangeTypeClassification": {
    "DocumentationExtensions": [ ".md", ".txt", ".rst" ],
    "DocumentationDirectories": [ "docs/", "doc/" ],
    "PackagingExtensions": [ ".spec", ".patch", ".diff" ],
    "PackagingDirectories": [ "SPECS/", "SOURCES/" ],
    "FrontendExtensions": [ ".vue", ".ts", ".js", ".jsx", ".tsx", ".html", ".css", ".scss", ".less" ],
    "PackageRepositories": [ "openRuyi" ],
    "HomepageRepositories": [ "homepage" ]
  },
  "StaleLifecycle": {
    "Enabled": false,
    "DryRun": true,
    "MonitoredRepositories": [],
    "ExcludedRepositories": [],
    "StaleDays": 30,
    "CloseDays": 7,
    "ExemptLabels": [
      "Status: Pinned",
      "Workflow: Blocked",
      "Security",
      "Epic"
    ],
    "StaleCommentTemplate": "This issue or pull request has been automatically marked as stale because it has not had recent activity within the last {StaleDays} days. It will be closed in {CloseDays} days if no further activity occurs. If this is still relevant, please comment or push a commit to keep it active. Thank you for your contributions!",
    "CloseCommentTemplate": "This issue or pull request was closed because it has been stalled for over {CloseDays} days with no activity after being marked as stale. Feel free to reopen it or file a new one if you would like to continue the work.",
    "CheckIntervalHours": 24,
    "RequestThrottleMilliseconds": 500,
    "MinRateLimitRemaining": 100
  },
  "BotDetection": {
    "Whitelist": [
      "github-actions",
      "github-actions[bot]",
      "abaci-bot",
      "abaci-bot[bot]",
      "dependabot",
      "dependabot[bot]"
    ]
  },
  "SpdxCompliance": {
    "Enabled": true,
    "UpdateRemoteUrl": "https://spdx.org/licenses/licenses.json",
    "UpdateExceptionsRemoteUrl": "https://spdx.org/licenses/exceptions.json",
    "AutoUpdateIntervalHours": 24,
    "AllowLegacyAliases": true
  },
  "CveSecurity": {
    "Enabled": true,
    "OsvApiBaseUrl": "https://api.osv.dev/v1/vulns/",
    "NvdApiBaseUrl": "https://services.nvd.nist.gov/rest/json/cves/2.0",
    "NvdApiKey": null,
    "CacheExpirationHours": 12,
    "UnknownCacheExpirationHours": 1,
    "RequestTimeoutSeconds": 15
  },
  "RebuildImpact": {
    "Enabled": true,
    "PrimaryXmlUrl": null,
    "LocalCachePath": null,
    "RefreshIntervalHours": 6,
    "CalculationMode": "Transitive",
    "MaxDepth": null,
    "BlockThreshold": 1001,
    "TargetBranchToBlock": "Rolling"
  },
  "AbiCompliance": {
    "Enabled": true,
    "AbidiffExecutablePath": "abidiff",
    "StableRpmBaseUrl": null,
    "TempExtractionDirectory": null
  }
}
