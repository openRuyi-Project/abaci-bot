<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura,opencover</Format>
          <Include>[abaci-bot]*</Include>
          <Exclude>[*Tests*]*,[abaci-bot]System.Text.RegularExpressions.Generated.*</Exclude>
          <ExcludeByAttribute>ExcludeFromCodeCoverageAttribute,GeneratedCodeAttribute</ExcludeByAttribute>
          <SingleHit>false</SingleHit>
          <!-- Note: Coverlet VSTest collector (collector integration) does not validate Threshold at process exit.
               Coverage thresholds (line >= 80%, branch >= 80%) are explicitly asserted in CI via test verification step. -->
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
